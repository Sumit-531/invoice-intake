# Google AI Studio — free tier, no card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults below are exactly what the assignment specifies, so leaving this file
# untouched apart from the key above gives the documented behaviour.
#
# Set ACCOUNTING_API_URL only if something else on your machine already owns port 8080 on
# loopback. accounting_api.py binds 0.0.0.0, so it stays reachable on the machine's own
# hostname or LAN address even when localhost is taken.
# ACCOUNTING_API_URL=http://localhost:8080
# ACCOUNTING_API_KEY=demo-key-1234

# Optional. gemini-3.6-flash by default, pinned rather than "latest" so a run is
# reproducible. Note that gemini-2.5-flash is no longer open to new API keys.
# GEMINI_MODEL=gemini-3.6-flash
